# General commands work in every WhatsApp group the bot has joined.
# Set these only if you want to maintain an explicit allowlist.
GROUP_ID=
GROUP_IDS=

# PostgreSQL persistence
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
POSTGRES_DB=pbbot
POSTGRES_USER=pbbot
POSTGRES_PASSWORD=change-me

# Media commands also work in every joined group when this is empty.
MEDIA_GROUP_ID=

# Incident alerts
INCIDENT_GROUP_ID=<incident-whatsapp-group-id>@g.us
INCIDENT_PORT=8081

# Subgroup feature — comma-separated phone numbers blocked from using subgroups
SUBGROUP_BLOCKED_USERS=
