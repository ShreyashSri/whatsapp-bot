# WhatsApp group IDs (comma-separated for multiple)
GROUP_ID=<primary-whatsapp-group-id>@g.us
GROUP_IDS=<extra-whatsapp-group-id>@g.us
# Inbound commands are accepted only in this group. Defaults to GROUP_ID.
PBBOT_GROUP_ID=<primary-whatsapp-group-id>@g.us

# PostgreSQL persistence
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Seed after startup with: python -m db.seed_admin <jid>
POSTGRES_DB=pbbot
POSTGRES_USER=pbbot
POSTGRES_PASSWORD=change-me

# Media team
MEDIA_GROUP_ID=<media-whatsapp-group-id>@g.us

# Incident alerts
INCIDENT_GROUP_ID=<incident-whatsapp-group-id>@g.us
INCIDENT_PORT=8081

# Subgroup feature — comma-separated phone numbers blocked from using subgroups
SUBGROUP_BLOCKED_USERS=
