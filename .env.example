# WhatsApp group IDs (comma-separated for multiple)
GROUP_ID=<primary-whatsapp-group-id>@g.us
GROUP_IDS=<extra-whatsapp-group-id>@g.us
# Inbound commands are accepted only in this group. Defaults to GROUP_ID.
PBBOT_GROUP_ID=<primary-whatsapp-group-id>@g.us

# PostgreSQL persistence
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Seed after startup with: python -m db.seed_admin <jid>
POSTGRES_DB=pbbot
POSTGRES_USER=pbbot
POSTGRES_PASSWORD=change-me

# Natural-language commands (only messages that mention the bot are translated)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_CARD_MODEL=mistral-medium-3-5
# Optional comma-separated public URLs whose title/description can enrich
# natural-language requests. Only explicit URLs are fetched; page instructions
# are treated as untrusted evidence.
NATURAL_LANGUAGE_KNOWLEDGE_URLS=
# Optional; the bot's JID and LID are discovered from Neonize when connected.
# The literal @me alias is also accepted for testing and resolves to the sender.
BOT_JID=

# Media team
MEDIA_GROUP_ID=<media-whatsapp-group-id>@g.us

# Team reminders
# Replies to tracked reminders are accepted in this group; ordinary commands
# remain limited to PBBOT_GROUP_ID and MEDIA_GROUP_ID.
REMINDER_GROUP_ID=<reminder-whatsapp-group-id>@g.us

# Incident alerts
INCIDENT_GROUP_ID=<incident-whatsapp-group-id>@g.us
INCIDENT_PORT=8081

# Fellowship Tracker alerts
# The tracker POSTs new/reopened opportunities to this bot endpoint.
# Leave blank to send to PBBOT_GROUP_ID, or set a separate group JID.
FELLOWSHIP_ALERT_GROUP_ID=
FELLOWSHIP_ALERT_SECRET=replace-with-a-long-random-secret
FELLOWSHIP_ALERT_PORT=8082

# Subgroup feature — comma-separated phone numbers blocked from using subgroups
SUBGROUP_BLOCKED_USERS=
