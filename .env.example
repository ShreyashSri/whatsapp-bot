# WhatsApp group IDs (comma-separated for multiple)
GROUP_ID=<primary-whatsapp-group-id>@g.us
GROUP_IDS=<extra-whatsapp-group-id>@g.us

# Media team
MEDIA_GROUP_ID=<media-whatsapp-group-id>@g.us

# Incident alerts
INCIDENT_GROUP_ID=<incident-whatsapp-group-id>@g.us
INCIDENT_PORT=8081

# Subgroup feature — comma-separated phone numbers blocked from using subgroups
SUBGROUP_BLOCKED_USERS=

# Task manager
TASKS_GROUP_ID=<tasks-whatsapp-group-id>@g.us
TASK_ADMINS=<admin-wa-id>@s.whatsapp.net,<another-admin>@s.whatsapp.net

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pbbot
